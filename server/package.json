{
  "name": "newsora-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/app.ts",
    "dev:worker:ingest": "tsx watch src/workers/ingest.worker.ts",
    "dev:worker:agent": "tsx watch src/workers/agent.worker.ts",
    "build": "tsc --project tsconfig.json",
    "start": "node dist/app.js",
    "start:worker:ingest": "node dist/workers/ingest.worker.js",
    "start:worker:agent": "node dist/workers/agent.worker.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^1.0.0",
    "@langchain/core": "^0.3.0",
    "@langchain/langgraph": "^1.4.18",
    "@mozilla/readability": "^0.5.0",
    "argon2": "^0.41.0",
    "axios": "^1.7.0",
    "bullmq": "^5.0.0",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.0",
    "express": "^4.21.0",
    "express-rate-limit": "^7.0.0",
    "groq-sdk": "^0.8.0",
    "helmet": "^8.0.0",
    "ioredis": "^5.3.0",
    "jsdom": "^25.0.0",
    "jsonwebtoken": "^9.0.0",
    "mongoose": "^8.0.0",
    "p-limit": "^3.1.0",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "passport-jwt": "^4.0.0",
    "pino": "^9.0.0",
    "pino-http": "^10.0.0",
    "rss-parser": "^3.13.0",
    "socket.io": "^4.8.0",
    "uuid": "^10.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/compression": "^1.7.5",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsdom": "^21.1.7",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.0.0",
    "@types/passport": "^1.0.16",
    "@types/passport-google-oauth20": "^2.0.14",
    "@types/passport-jwt": "^4.0.1",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vitest/coverage-v8": "^2.0.0",
    "eslint": "^8.57.0",
    "mongodb-memory-server": "^10.0.0",
    "pino-pretty": "^11.0.0",
    "supertest": "^7.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.4.0",
    "vitest": "^2.0.0"
  }
}
