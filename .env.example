# ============================================================
# NewsOra — Environment Variables Template
# Copy this file to .env and fill in your actual values.
# NEVER commit your actual .env file to git.
# ============================================================

# === Server ===
NODE_ENV=development
PORT=3001

# === Database ===
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/newsora?retryWrites=true&w=majority

# === Redis (Upstash) ===
# Get from: https://upstash.com/
REDIS_URL=rediss://default:<token>@<endpoint>.upstash.io:6379

# === Authentication ===
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_minimum_32_char_random_string
JWT_REFRESH_SECRET=replace_with_different_minimum_32_char_random_string
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# === Google OAuth ===
# Get from: https://console.cloud.google.com/
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:3001/api/v1/auth/google/callback

# === AI Providers ===
# Groq: https://console.groq.com/
GROQ_API_KEY=gsk_your_groq_api_key

# Gemini: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key

# OpenRouter (optional fallback): https://openrouter.ai/
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_key

# === News APIs ===
# GNews: https://gnews.io/
GNEWS_API_KEY=your_gnews_api_key

# Tavily: https://tavily.com/
TAVILY_API_KEY=tvly-your_tavily_api_key

# === CORS ===
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173

# === Frontend URL (for OAuth redirect) ===
CLIENT_URL=http://localhost:5173

# === Logging ===
LOG_LEVEL=info

# === Ingestion Settings ===
INGESTION_INTERVAL_MINUTES=15
MAX_ARTICLES_PER_CYCLE=50
ARTICLE_TTL_DAYS=30

# === Vector DB ===
# Options: atlas | qdrant
VECTOR_DB_PROVIDER=atlas

# If using Qdrant:
# QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=

# === Feature Flags ===
ENABLE_SOCKET_IO=true
ENABLE_ALERTS=true
